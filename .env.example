# Telegram Bot Configuration
# BotFather'dan aldığınız token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Hedef chat/channel ID (örn: -1001234567890 veya @channelusername)
# @userinfobot ile öğrenebilirsiniz
TELEGRAM_CHAT_ID=your_chat_id_here

# NVIDIA NIM API Configuration
# https://build.nvidia.com/ adresinden API key alın
NVIDIA_API_KEY=your_nvidia_api_key_here

# NIM API Base URL (model sayfasından kopyalayın)
# Örn: https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Kullanılacak model adı (NIM catalog'dan seçin)
# Örn: meta/llama-3.1-70b-instruct, mistralai/mixtral-8x7b-instruct, google/gemma-2-27b-it
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# News API Keys (Opsiyonel - en az biri önerilir)
# https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here

# https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here